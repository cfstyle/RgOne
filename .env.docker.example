# 复制为 .env，在目标服务器上填写。各密钥应独立生成。
APP_SECRET_KEY=
JWT_SECRET=
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# 宿主机监听端口。Nginx 容器内部固定为 80。
RGONE_PORT=8000
# 使用共享镜像时，构建机和内网部署机采用相同的镜像引用。
# RGONE_PYTHON_IMAGE=python:3.11-slim-bookworm
# RGONE_NGINX_IMAGE=nginx:1.28-alpine

# production 使用真实网关，test 使用独立的测试数据和模拟网关。
APP_ENV=production
# 生产环境填写真实网关地址和服务账号。
NEW_API_BASE_URL=
NEW_API_ACCESS_TOKEN=
NEW_API_USER_ID=1

# 接入真实行内通知服务时填写。
XIAOMISHU_API=
XIAOMISHU_SEND_USER=
XIAOMISHU_TEST_MODE=false
